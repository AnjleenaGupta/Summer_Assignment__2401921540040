class Solution {
public:
    string decodeString(string s) {
     stack<pair<string,int>> st;
     string temp="";
      int num=0;
      for(int i=0;i<s.size();i++){
        if(isdigit(s[i])){
            num=num*10 +(s[i]-'0');
        }
       else if(s[i]=='['){
            st.push({temp,num});
            temp="";
            num=0;
        }
        else if(isalpha(s[i])){
            temp +=s[i];
        }
        else if(s[i]==']'){
          string prev= st.top().first;
          int repeat= st.top().second;
          st.pop();
        
        string ans="";
        while(repeat>0){
            ans += temp;;
            repeat--;
        }
        temp= prev+ ans;

        }
      }  
      return temp;
    }
};