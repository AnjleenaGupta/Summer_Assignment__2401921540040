class MyQueue {
    private:
    stack<int> s;
    stack<int> m;

public:
    MyQueue() {
        
    }
    
    void push(int x) {
        s.push(x);
      
    }
    
    int pop() {
        peek();
        int top= m.top();
        m.pop();
        return top;
        
    }
    
    int peek() {
        if(m.empty()){
            while(!s.empty()){
                m.push(s.top());
                s.pop();
            }
        }
        return m.top();
    }
    
    bool empty() {
        if(s.empty() && m.empty())
        return true;
        else
        return false;
    }
};

